<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.order-flow.dev</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__NPM_CLI__</string>
		<string>run</string>
		<string>start:dhan</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__ROOT__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MF_PROVIDER</key>
		<string>dhan</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/order-flow.launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/order-flow.launchd.err.log</string>
</dict>
</plist>
